#!/data/data/com.termux/files/usr/bin/sh
# xfce4-keyboard-settings (Termux On DeX): al posto del pannello di XFCE si aprono le Impostazioni, voce tastiera.
# share/bin viene prima nel PATH della sessione (session_xstartup): vale per menu e tasto destro.
exec python3 "$(dirname "$(readlink -f "$0")")/../tod-settings.py" tastiera
